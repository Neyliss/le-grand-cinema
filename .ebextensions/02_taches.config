# Tâches planifiées du serveur (cron). Un seul serveur hors festival : elles ne tournent qu'une fois.
packages:
  yum:
    cronie: []

files:
  "/etc/cron.d/grandcinema":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Chaque minute : les sièges bloqués depuis plus de 10 minutes sans paiement sont rendus
      * * * * * root /bin/bash /var/app/current/deploiement/tache.sh liberer_places > /dev/null 2>&1
      # Chaque nuit (0 h UTC, 4 h à La Réunion) : la démonstration est rechargée pour les 7 jours suivants
      0 0 * * * root /bin/bash /var/app/current/deploiement/tache.sh charger_demo --reinitialiser >> /var/log/grandcinema-demo.log 2>&1

commands:
  01_demarrer_cron:
    command: "systemctl enable --now crond"
