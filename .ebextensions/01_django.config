# Configuration de l'environnement Elastic Beanstalk « gc-prod » (dossier 3 du bloc 1, composant C3).
# Les secrets (SECRET_KEY, mot de passe de la base…) ne sont jamais écrits ici : ils se saisissent
# dans la console Elastic Beanstalk (Configuration > Propriétés de l'environnement).
# Guide pas à pas : docs/guide-aws.md
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: grandcinema.settings
    DEBUG: "False"
    TIME_ZONE: Europe/Paris
    # Site de démonstration : paiement simulé (aucune clé Stripe), lien de confirmation affiché à l'écran
    PAIEMENT_DEMO: "True"
    # Affiches des films hors du dossier de l'application : conservées d'un déploiement à l'autre
    MEDIA_ROOT: /var/app/media
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

container_commands:
  01_migrer:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
    leader_only: true
  02_fichiers_statiques:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py collectstatic --noinput"
  03_dossier_des_affiches:
    command: "mkdir -p /var/app/media"
  04_donnees_de_demonstration:
    # Charge la démonstration la première fois ; ensuite, seulement si la programmation est périmée
    command: "source /var/app/venv/*/bin/activate && python3 manage.py charger_demo --si-perime"
    leader_only: true
  05_droits_du_site_sur_les_affiches:
    # Le site tourne avec l'utilisateur « webapp » (pas administrateur) : il doit pouvoir y écrire
    command: "chown -R webapp:webapp /var/app/media"
