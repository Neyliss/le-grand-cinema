# Configuration de l'environnement Elastic Beanstalk « gc-prod » (dossier 3, composant C3).
# Les secrets (SECRET_KEY, DATABASE_URL, clés Stripe, SES) se saisissent dans la console
# Elastic Beanstalk : Configuration > Mises à jour, surveillance et journalisation > Propriétés de l'environnement.
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: grandcinema.settings
    DEBUG: "False"
    TIME_ZONE: Europe/Paris
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

container_commands:
  01_migrer:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate --noinput"
    leader_only: true
  02_fichiers_statiques:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py collectstatic --noinput"
