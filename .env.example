# Copier ce fichier en « .env » pour le développement local.
DEBUG=True
SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
ALLOWED_HOSTS=localhost,127.0.0.1

# Vide = SQLite (fichier db.sqlite3).
# PostgreSQL en local (Postgres.app) : postgres://localhost:5432/grandcinema
# Production (Amazon RDS) : postgres://utilisateur:motdepasse@hote:5432/grandcinema
DATABASE_URL=

# Stripe en mode test (https://dashboard.stripe.com/test/apikeys). Vide = paiement simulé.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails : par défaut affichés dans le terminal.
