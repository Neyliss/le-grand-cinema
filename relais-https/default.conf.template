# Relais HTTPS : Render reçoit les visiteurs en HTTPS et transmet tout au serveur Elastic Beanstalk,
# exactement comme CloudFront (C2) le ferait. Le site (C3) et la base RDS (C4) restent sur AWS.
server {
    listen ${PORT};
    server_tokens off;
    client_max_body_size 10m;

    location / {
        proxy_pass http://${ORIGINE};
        # Le site connaît son adresse publique (…onrender.com) : liens, formulaires et cookies corrects
        proxy_set_header Host $host;
        # Même en-tête que CloudFront : le site sait que la visite est en HTTPS
        # (cookies sécurisés, protection CSRF, HSTS), sans aucun changement de son code
        proxy_set_header CloudFront-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}
